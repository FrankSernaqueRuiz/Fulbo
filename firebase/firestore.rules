rules_version = '2';

// ============================================================================
// FULBO - Reglas de seguridad de Cloud Firestore
//
// Idea general:
//   * La app (cliente) solo LEE casi todo y ESCRIBE muy poco.
//   * Todo lo que mueve cupos, reputacion, plan o dinero lo escriben las
//     Cloud Functions con el Admin SDK, que se salta estas reglas.
//   * Si una regla no dice "allow", esta prohibido.
//
// Probar en local:  firebase emulators:start   (en la carpeta firebase/)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda -------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function esYo(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Acepta correo verificado o autenticación por número de teléfono
    function correoVerificado() {
      return signedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider == 'phone')
      );
    }

    function esAdmin() {
      // Se asigna con un custom claim desde el Admin SDK: { admin: true }
      return signedIn() && request.auth.token.admin == true;
    }

    function rutaUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    // El documento usuarios/{uid} solo lo crea la funcion completarPerfil
    // despues de verificar la edad. Si existe, el perfil esta completo.
    function perfilCompleto() {
      return correoVerificado() && exists(rutaUsuario(request.auth.uid));
    }

    function esPremium() {
      return perfilCompleto()
        && get(rutaUsuario(request.auth.uid)).data.plan == 'premium';
    }

    function rutaDueno(uid) {
      return /databases/$(database)/documents/duenos_cancha/$(uid);
    }

    // Un dueno se registra solo, pero nace SIN verificar. Hasta que un admin
    // lo apruebe (funcion verificarDueno) no puede publicar ninguna cancha.
    function esDuenoVerificado() {
      return correoVerificado()
        && exists(rutaDueno(request.auth.uid))
        && get(rutaDueno(request.auth.uid)).data.verificado == true;
    }

    function datosCanchaValidos() {
      return request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.direccion is string
        && request.resource.data.direccion.size() <= 160
        && request.resource.data.distrito is string
        && request.resource.data.distrito.size() <= 60
        && request.resource.data.ciudad is string
        && request.resource.data.ciudad.size() <= 60
        && request.resource.data.ubicacion is latlng
        && request.resource.data.superficie in ['sintetico', 'grass', 'losa', 'cemento']
        && request.resource.data.formatos is list
        && request.resource.data.formatos.size() >= 1
        && request.resource.data.formatos.size() <= 4
        && request.resource.data.formatos.hasOnly(['4v4', '5v5', '7v7', '11v11'])
        && request.resource.data.techada is bool
        && request.resource.data.precio_hora is number
        && request.resource.data.precio_hora >= 0
        && request.resource.data.precio_hora <= 1000
        && request.resource.data.abre_min is int
        && request.resource.data.abre_min >= 0
        && request.resource.data.abre_min <= 1440
        && request.resource.data.cierra_min is int
        && request.resource.data.cierra_min >= 0
        && request.resource.data.cierra_min <= 1440
        && request.resource.data.activa is bool
        && (!('telefono' in request.resource.data)
            || (request.resource.data.telefono is string
                && request.resource.data.telefono.matches('[0-9]{6,9}')));
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function puntaje(v) {
      return v is int && v >= 1 && v <= 5;
    }

    // ---------- usuarios ------------------------------------------------------
    // Perfil publico: legible por el propio usuario o por cualquiera con perfil completo (REG-01).
    match /usuarios/{uid} {
      allow read: if signedIn() && (esYo(uid) || perfilCompleto());

      // Crear: permite al usuario guardar su perfil inicial o via Cloud Function.
      allow create: if esYo(uid);
      allow delete: if esYo(uid) || esAdmin();

      // El dueno solo puede editar datos cosmeticos con validaciones de tipo y tamano (REG-04).
      allow update: if esYo(uid)
        && soloCambia(['alias', 'ciudad', 'posicion', 'nivel', 'ubicacion', 'foto_url'])
        && (!('alias' in request.resource.data)
            || (request.resource.data.alias is string && request.resource.data.alias.size() <= 30))
        && (!('ciudad' in request.resource.data)
            || (request.resource.data.ciudad is string && request.resource.data.ciudad.size() <= 60))
        && (!('ubicacion' in request.resource.data)
            || request.resource.data.ubicacion == null
            || request.resource.data.ubicacion is latlng)
        && (!('foto_url' in request.resource.data)
            || request.resource.data.foto_url == null
            || (request.resource.data.foto_url is string && request.resource.data.foto_url.size() <= 500))
        && (!('posicion' in request.resource.data)
            || request.resource.data.posicion in ['arquero', 'defensa', 'medio', 'delantero'])
        && (!('nivel' in request.resource.data)
            || request.resource.data.nivel in ['recien', 'casual', 'intermedio', 'competitivo']);

      // Datos personales (fecha_nacimiento, aceptacion de terminos): solo los lee y escribe el dueno.
      match /privado/{doc} {
        allow read, write: if esYo(uid);
      }

      // Tokens de notificaciones push (FCM), uno por dispositivo (REG-09).
      match /dispositivos/{token} {
        allow read, delete: if esYo(uid);
        allow create, update: if esYo(uid)
          && token.size() <= 256
          && request.resource.data.keys().hasOnly(['plataforma', 'actualizado_en'])
          && request.resource.data.plataforma in ['android', 'ios']
          && request.resource.data.actualizado_en == request.time;
      }
    }

    // Acumuladores de reputacion: solo servidor.
    match /reputacion/{uid}       { allow read, write: if false; }

    // ---------- duenos de cancha y canchas -----------------------------------
    // REG-02: solo el propio dueno o un admin pueden leer datos sensibles (RUC, razon social).
    match /duenos_cancha/{uid} {
      allow read: if esYo(uid) || esAdmin();

      allow create: if esYo(uid)
        && correoVerificado()
        && request.resource.data.verificado == false
        && request.resource.data.keys().hasOnly(['razon_social', 'ruc', 'telefono', 'verificado'])
        && request.resource.data.keys().hasAll(['razon_social', 'ruc', 'telefono', 'verificado'])
        && request.resource.data.razon_social is string
        && request.resource.data.razon_social.size() >= 3
        && request.resource.data.razon_social.size() <= 120
        && request.resource.data.ruc is string
        && request.resource.data.ruc.matches('[0-9]{11}')
        && request.resource.data.telefono is string
        && request.resource.data.telefono.matches('[0-9]{6,9}');

      allow update: if esYo(uid)
        && soloCambia(['razon_social', 'telefono']);

      allow delete: if false;
    }

    match /canchas/{canchaId} {
      allow read: if signedIn();

      allow create: if esDuenoVerificado()
        && request.resource.data.dueno_uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'dueno_uid', 'nombre', 'direccion', 'distrito', 'ciudad',
             'ubicacion', 'superficie', 'formatos', 'techada', 'precio_hora',
             'abre_min', 'cierra_min', 'telefono', 'activa', 'creado_en'])
        && request.resource.data.keys().hasAll([
             'dueno_uid', 'nombre', 'direccion', 'distrito', 'ciudad',
             'ubicacion', 'superficie', 'formatos', 'techada', 'precio_hora',
             'abre_min', 'cierra_min', 'activa', 'creado_en'])
        && datosCanchaValidos()
        && request.resource.data.activa == true
        && request.resource.data.creado_en == request.time;

      allow update: if esDuenoVerificado()
        && resource.data.dueno_uid == request.auth.uid
        && soloCambia([
             'nombre', 'direccion', 'distrito', 'ciudad', 'ubicacion',
             'superficie', 'formatos', 'techada', 'precio_hora',
             'abre_min', 'cierra_min', 'telefono', 'activa'])
        && datosCanchaValidos();

      allow delete: if false;
    }

    // ---------- partidos ------------------------------------------------------
    match /partidos/{partidoId} {
      allow read: if signedIn();

      allow create: if perfilCompleto()
        && request.resource.data.keys().hasOnly([
             'organizador_uid', 'cancha_id', 'cancha_nombre', 'equipo_id',
             'fecha_hora', 'formato', 'cupos_totales', 'cupos_libres',
             'nivel_buscado', 'rep_minima', 'costo_persona', 'cancha_confirmada',
             'ubicacion', 'ciudad', 'descripcion', 'estado', 'creado_en'])
        && request.resource.data.organizador_uid == request.auth.uid
        && request.resource.data.estado == 'publicado'
        && request.resource.data.cancha_nombre is string
        && request.resource.data.cancha_nombre.size() <= 100
        && request.resource.data.ciudad is string
        && request.resource.data.ciudad.size() <= 60
        && (!('descripcion' in request.resource.data)
            || request.resource.data.descripcion == null
            || (request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 300))
        && (!('rep_minima' in request.resource.data)
            || request.resource.data.rep_minima == null
            || (request.resource.data.rep_minima is number && request.resource.data.rep_minima >= 1 && request.resource.data.rep_minima <= 5))
        && request.resource.data.fecha_hora is timestamp
        && request.resource.data.fecha_hora > request.time
        && request.resource.data.formato in ['4v4', '5v5', '7v7', '11v11']
        && request.resource.data.nivel_buscado in ['recien', 'casual', 'intermedio', 'competitivo']
        && request.resource.data.cupos_totales is int
        && request.resource.data.cupos_totales >= 2
        && request.resource.data.cupos_totales <= 30
        && request.resource.data.cupos_libres == request.resource.data.cupos_totales - 1
        && request.resource.data.costo_persona is number
        && request.resource.data.costo_persona >= 0
        && request.resource.data.cancha_confirmada is bool
        && request.resource.data.ubicacion is latlng
        && request.resource.data.creado_en == request.time;

      allow update: if signedIn()
        && resource.data.organizador_uid == request.auth.uid
        && resource.data.estado in ['publicado', 'completo']
        && soloCambia(['cancha_confirmada', 'descripcion', 'costo_persona'])
        && (!('costo_persona' in request.resource.data) || (request.resource.data.costo_persona is number && request.resource.data.costo_persona >= 0))
        && (!('descripcion' in request.resource.data)
            || request.resource.data.descripcion == null
            || (request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 300));

      allow delete: if false;

      // REG-03: Inscripciones solo legibles por el propio jugador o el organizador
      match /inscripciones/{uid} {
        allow read: if signedIn() && (
          esYo(uid) ||
          get(/databases/$(database)/documents/partidos/$(partidoId)).data.organizador_uid == request.auth.uid
        );
        allow write: if false;
      }

      // Calificaciones: id = "<emisor>_<receptor>" -> una por pareja y partido.
      match /calificaciones/{calId} {
        allow read: if signedIn() && (
          resource.data.emisor_uid == request.auth.uid ||
          resource.data.receptor_uid == request.auth.uid
        );

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
               'emisor_uid', 'receptor_uid', 'puntualidad', 'asistencia',
               'pago', 'trato', 'comentario', 'creado_en'])
          && request.resource.data.emisor_uid == request.auth.uid
          && request.resource.data.receptor_uid != request.auth.uid
          && calId == request.auth.uid + '_' + request.resource.data.receptor_uid
          && get(/databases/$(database)/documents/partidos/$(partidoId)).data.estado == 'en_calificacion'
          && get(/databases/$(database)/documents/partidos/$(partidoId)/inscripciones/$(request.auth.uid)).data.asistio == true
          && get(/databases/$(database)/documents/partidos/$(partidoId)/inscripciones/$(request.resource.data.receptor_uid)).data.asistio == true
          && puntaje(request.resource.data.puntualidad)
          && puntaje(request.resource.data.asistencia)
          && puntaje(request.resource.data.pago)
          && puntaje(request.resource.data.trato)
          && (!('comentario' in request.resource.data)
              || (request.resource.data.comentario is string
                  && request.resource.data.comentario.size() <= 140))
          && request.resource.data.creado_en == request.time;

        allow update, delete: if false;
      }
    }

    // Colección grupo de calificaciones para consultar reseñas recibidas
    match /{path=**}/calificaciones/{calId} {
      allow read: if signedIn() && (
        resource.data.receptor_uid == request.auth.uid ||
        resource.data.emisor_uid == request.auth.uid
      );
    }

    // ---------- equipos fijos (Premium) --------------------------------------
    match /equipos/{equipoId} {
      allow read: if signedIn();
      allow create: if esPremium()
        && request.resource.data.creador_uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['nombre', 'ciudad', 'formato', 'creador_uid', 'creado_en'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.nombre.size() <= 50
        && request.resource.data.ciudad is string
        && request.resource.data.ciudad.size() <= 60
        && request.resource.data.formato in ['4v4', '5v5', '7v7', '11v11'];

      // REG-06: Validar en update exigiendo perfilCompleto
      allow update: if perfilCompleto()
        && resource.data.creador_uid == request.auth.uid
        && soloCambia(['nombre', 'ciudad', 'formato'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.nombre.size() <= 50
        && request.resource.data.ciudad is string
        && request.resource.data.ciudad.size() <= 60
        && request.resource.data.formato in ['4v4', '5v5', '7v7', '11v11'];

      allow delete: if signedIn() && resource.data.creador_uid == request.auth.uid;

      // REG-07: Invitaciones con consentimiento y control de estados
      match /miembros/{uid} {
        allow read: if signedIn();
        allow write: if signedIn()
          && (
            (get(/databases/$(database)/documents/equipos/$(equipoId)).data.creador_uid == request.auth.uid) ||
            esYo(uid)
          )
          && (request.resource == null || (
               request.resource.data.keys().hasOnly(['rol', 'estado'])
               && request.resource.data.rol in ['titular', 'suplente']
               && request.resource.data.estado in ['pendiente', 'aceptado', 'rechazado']
          ));
      }
    }

    // ---------- suscripciones (las escribe el webhook de pago) ---------------
    match /suscripciones/{id} {
      allow read: if signedIn() && resource.data.usuario_uid == request.auth.uid;
      allow write: if false;
    }

    // ---------- reportes (moderacion) ----------------------------------------
    // REG-08: Validación completa y prevención de duplicados
    match /reportes/{id} {
      allow create: if perfilCompleto()
        && request.resource.data.keys().hasOnly(['reportante_uid', 'reportado_uid', 'partido_id', 'motivo', 'estado', 'creado_en'])
        && request.resource.data.reportante_uid == request.auth.uid
        && request.resource.data.reportado_uid != request.auth.uid
        && request.resource.data.partido_id is string
        && request.resource.data.estado == 'abierto'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 5
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.creado_en == request.time;
      allow read, update: if esAdmin();
      allow delete: if false;
    }
  }
}
